{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-guard.sh",
            "args": [],
            "onFailure": "block",
            "statusMessage": "evidence-gates: checking doc citations and pre-registrations before the commit"
          }
        ]
      }
    ]
  }
}
